{
  "name": "paige-rattenberry-site",
  "version": "0.1.0",
  "private": true,
  "description": "Paige Rattenberry's portfolio site. Next.js 16, statically generated, built with Claude Code.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "tsx scripts/build-resume.tsx",
    "dev": "next dev",
    "prebuild": "tsx scripts/layout-explorer.ts --check && node scripts/build-fonts.mjs --check && tsx scripts/build-resume.tsx",
    "build": "next build",
    "start": "next start",
    "budget": "node scripts/js-budget.mjs / --max-site-kb=15",
    "layout:explorer": "tsx scripts/layout-explorer.ts",
    "fonts": "node scripts/build-fonts.mjs",
    "resume": "tsx scripts/build-resume.tsx",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "tsx scripts/build-resume.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "e2e:features": "playwright test tests/e2e/projects.spec.ts tests/e2e/explorer.spec.ts tests/e2e/seo.spec.ts tests/e2e/fonts.spec.ts",
    "e2e:screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "d3-force": "3.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.4",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@next/env": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10",
    "fontverter": "2.0.0",
    "happy-dom": "^20.14.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "subset-font": "2.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
